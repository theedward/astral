{
  "name": "astral-companion",
  "version": "0.6.4",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "Your addons and your interface, at home on every computer.",
  "main": "desktop/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "start": "electron .",
    "test": "node --test tests/*.test.mjs",
    "package:mac": "npm run build && node scripts/package-mac.mjs",
    "package:windows": "npm run build && electron-builder --win nsis --x64 --publish never"
  },
  "dependencies": {
    "@wowserhq/format": "^0.28.0",
    "lucide-react": "^0.468.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "yauzl": "^3.2.0"
  },
  "devDependencies": {
    "electron": "45.1.0",
    "electron-builder": "26.18.0",
    "prettier": "^3.9.10",
    "vite": "8.3.5"
  },
  "build": {
    "appId": "com.joaoseixas.astral",
    "productName": "Astral",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "desktop/**/*",
      "package.json",
      "assets/**/*"
    ],
    "mac": {
      "category": "public.app-category.utilities",
      "hardenedRuntime": false,
      "identity": "-",
      "icon": "assets/icon.png"
    },
    "win": {
      "target": "nsis",
      "icon": "assets/icon.png"
    },
    "artifactName": "Astral-${version}-${os}-${arch}.${ext}",
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Astral-${version}-win-${arch}.exe"
    }
  },
  "author": "Joao Seixas"
}
